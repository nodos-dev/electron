From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Can Oguz <can.oguz@nodos.dev>
Date: Mon, 9 Nov 2026 13:32:49 +0300
Subject: Fix Chromium reading fenced textures before they are ready

Advance the sync token after registering a D3D fence and after waiting
on the producer token. Forward the external fence through the compound
image backing and keep registration state with its mailbox.

Job-Id: accelerate-electronode-texture-inputs

diff --git a/gpu/command_buffer/service/shared_image/compound_image_backing.cc b/gpu/command_buffer/service/shared_image/compound_image_backing.cc
index 65bbf02e8b43a7f9ddbfd5e69cbb80398d5fa3f3..bf31acb63aaa5beecdb8989b9185587e2d5afd06 100644
--- a/gpu/command_buffer/service/shared_image/compound_image_backing.cc
+++ b/gpu/command_buffer/service/shared_image/compound_image_backing.cc
@@ -1449,6 +1449,20 @@ void CompoundImageBacking::Update(std::unique_ptr<gfx::GpuFence> in_fence) {
   element.content_id_ = ++latest_content_id_;
 }
 
+#if BUILDFLAG(IS_WIN)
+void CompoundImageBacking::UpdateExternalFence(
+    scoped_refptr<gfx::D3DSharedFence> external_fence) {
+  AutoLock auto_lock(this);
+  CHECK(!elements_.empty());
+  // The first backing owns the imported resource written by the producer.
+  // Copies into any sibling backing must read from it after the fence.
+  auto& element = elements_.front();
+  CHECK(element.backing);
+  element.backing->UpdateExternalFence(std::move(external_fence));
+  element.content_id_ = ++latest_content_id_;
+}
+#endif
+
 bool CompoundImageBacking::CopyToGpuMemoryBuffer() {
   AutoLock auto_lock(this);
   auto& shm_element = GetShmElement();
