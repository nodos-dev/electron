+void V8Platform::SetNowForScript(base::Time (*now_for_script)()) {
+  now_for_script_.store(now_for_script, std::memory_order_release);
+}
+
 double V8Platform::CurrentClockTimeMillis() {
-  return static_cast<double>(time_clamper_.ClampToMillis(base::Time::Now()));
+  return static_cast<double>(time_clamper_.ClampToMillis(NowForScript()));
 }
 
 int64_t V8Platform::CurrentClockTimeMilliseconds() {
-  return time_clamper_.ClampToMillis(base::Time::Now());
+  return time_clamper_.ClampToMillis(NowForScript());
 }
 
 double V8Platform::CurrentClockTimeMillisecondsHighResolution() {
-  return time_clamper_.ClampToMillisHighResolution(base::Time::Now());
+  return time_clamper_.ClampToMillisHighResolution(NowForScript());
+}
+
+base::Time V8Platform::NowForScript() const {
+  auto now_for_script = now_for_script_.load(std::memory_order_acquire);
+  return now_for_script ? now_for_script() : base::Time::Now();
 }
 
