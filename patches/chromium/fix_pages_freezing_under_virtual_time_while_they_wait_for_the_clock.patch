 // found in the LICENSE file.
 
+#include "base/functional/callback_helpers.h"
 #include "base/test/bind.h"
 #include "testing/gmock/include/gmock/gmock.h"
 #include "testing/gtest/include/gtest/gtest.h"
@@ -113,6 +114,27 @@ TEST(ProcessTimeOverrideCoordinatorTest, MultipleClients) {
   EXPECT_THAT(client2_callback_count, Eq(1));
 }
 
+TEST(ProcessTimeOverrideCoordinatorTest, ScriptClockMovesWhileTimeStandsStill) {
+  const base::TimeTicks start_ticks = base::TimeTicks::Now() + base::Seconds(5);
+  auto time_override = ProcessTimeOverrideCoordinator::CreateOverride(
+      kStartTime, start_ticks, base::DoNothing());
+
+  // Each reading while time stands still is a microsecond later than the last.
+  EXPECT_THAT(ProcessTimeOverrideCoordinator::NowTicksForScript(),
+              Eq(start_ticks));
+  EXPECT_THAT(ProcessTimeOverrideCoordinator::NowTicksForScript(),
+              Eq(start_ticks + base::Microseconds(1)));
+  EXPECT_THAT(ProcessTimeOverrideCoordinator::NowForScript(),
+              Eq(kStartTime + base::Microseconds(2)));
+  // The time everything else reads stays where it is.
+  EXPECT_THAT(base::TimeTicks::Now(), Eq(start_ticks));
+
+  // Once time moves past the readings, script reads it again.
+  time_override->TryAdvancingTime(start_ticks + base::Milliseconds(16));
+  EXPECT_THAT(ProcessTimeOverrideCoordinator::NowTicksForScript(),
+              Eq(start_ticks + base::Milliseconds(16)));
+}
