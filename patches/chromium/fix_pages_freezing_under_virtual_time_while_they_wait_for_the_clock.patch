@@ -68,15 +71,22 @@ class GIN_EXPORT V8Platform : public v8::Platform {
   v8::TracingController* GetTracingController() override;
   void DumpWithoutCrashing() override;
 
+  // Sets the clock script reads the time of day from, as Date.now() does.
