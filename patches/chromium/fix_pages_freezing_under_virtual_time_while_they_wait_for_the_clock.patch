       base::TimeTicks requested_ticks,
       base::RepeatingClosure schedule_work_callback);
 
+  // The time page script reads, as performance.now() and Date.now() do. While
+  // time is overridden it stands still during a task, so a reading that would
+  // not be later than the last one moves on by a microsecond, as time passes
+  // while script runs. A page that waits for the clock to change stops waiting.
+  static base::TimeTicks NowTicksForScript();
+  static base::Time NowForScript();
+
  private:
   friend class base::NoDestructor<ProcessTimeOverrideCoordinator>;
 
@@ -96,6 +103,8 @@ class PLATFORM_EXPORT ProcessTimeOverrideCoordinator {
   base::TimeTicks initial_ticks_;
 
   std::atomic<base::TimeTicks> current_ticks_;
+  // The last time NowTicksForScript() returned.
+  std::atomic<base::TimeTicks> last_script_ticks_;
 
   base::Lock lock_;
   std::unique_ptr<base::subtle::ScopedTimeClockOverrides> clock_override_
diff --git a/third_party/blink/renderer/platform/scheduler/common/process_time_override_coordinator_unittest.cc b/third_party/blink/renderer/platform/scheduler/common/process_time_override_coordinator_unittest.cc
